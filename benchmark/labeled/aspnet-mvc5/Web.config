<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="Shop" connectionString="Server=db.example.test;Database=Shop;User Id=shop_app;Password=EXAMPLE-NOT-REAL-shop-password;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="PaymentApiKey" value="EXAMPLE-NOT-REAL-payment-key" />
    <add key="MailPassword" value="" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
    <httpCookies httpOnlyCookies="false" requireSSL="false" />
    <machineKey validationKey="EXAMPLE-NOT-REAL-VALIDATION-KEY-0000000000000000" decryptionKey="EXAMPLE-NOT-REAL-DECRYPTION-KEY" validation="SHA1" />
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
